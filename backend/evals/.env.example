# 评测专用 Langfuse 项目（与 backend/.env 隔离，勿提交真实 key）
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-eval-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-eval-your-secret-key
LANGFUSE_BASE_URL=http://127.0.0.1:3000

# 被测模型 env 直连（noesis CLI 子进程；缺省回退内置目录）
# NOESIS_API_KEY 与 NOESIS_BASE_URL 同时提供即启用直连，--model 为端点真实模型名
NOESIS_API_KEY=sk-your-subject-model-key
NOESIS_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
NOESIS_MODEL=glm-5.3-flash
# OpenAI 兼容端点无需设置；其他类型按 MODEL_TYPE 取值
# NOESIS_MODEL_TYPE=openai
